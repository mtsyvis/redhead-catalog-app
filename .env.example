# Copy to .env and set values. Do not commit .env.
# Connection string (app uses key "DefaultConnection")
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=redhead_sites_catalog;Username=postgres;Password=CHANGE_ME

# Seed SuperAdmin (required for first run; password must meet complexity: digit, lower, upper, non-alphanumeric)
SEED_SUPERADMIN_EMAIL=superadmin@redhead.com
SEED_SUPERADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Optional: override in production
# ASPNETCORE_ENVIRONMENT=Production
# ASPNETCORE_URLS=http://+:8080

# Google Drive API credentials (required for Google Drive integration)
GOOGLE_DRIVE_CLIENT_ID=...
GOOGLE_DRIVE_CLIENT_SECRET=...
GOOGLE_DRIVE_REDIRECT_URI=https://example.com/api/integrations/google-drive/callback
GOOGLE_DRIVE_APP_NAME=Redhead Catalog
GOOGLE_DRIVE_EXPORT_FOLDER_NAME=Redhead Catalog Exports
FRONTEND_BASE_URL=https://catalog.rhda.us

# Google registration/sign-in (separate from Google Drive scopes; credentials may reference the same OAuth client)
GOOGLE_AUTH_ENABLED=false
GOOGLE_AUTH_CLIENT_ID=...
GOOGLE_AUTH_CLIENT_SECRET=...

# Invitation email through Google Workspace SMTP Relay (no SMTP authentication or credentials)
Email__Enabled=true
Email__SmtpHost=smtp-relay.gmail.com
Email__SmtpPort=587
Email__FromAddress=noreply@redheaddigital.agency
Email__FromName=Redhead Catalog
Email__SendTimeoutSeconds=10

# Weekly emergency Sites export to a Google Shared Drive folder (disabled unless explicitly enabled)
EmergencySitesExport__Enabled=false
EmergencySitesExport__ScheduleCron=30 3 * * MON
EmergencySitesExport__GoogleDriveFolderId=
EmergencySitesExport__ServiceAccountJsonPath=/run/secrets/google-service-account.json
EmergencySitesExport__RetentionWeeks=8
EmergencySitesExport__FilePrefix=redhead-sites-full
EmergencySitesExport__UploadTimeoutMinutes=30

# Exported domain access cleanup for client export usage limits
ExportedDomainAccessCleanup__Enabled=true
ExportedDomainAccessCleanup__RetentionDays=30
ExportedDomainAccessCleanup__BatchSize=1000
ExportedDomainAccessCleanup__IntervalHours=24

# Monthly Ahrefs Traffic/DR sync
Ahrefs__ApiKey=
Ahrefs__BaseUrl=https://api.ahrefs.com/v3
AhrefsSync__Enabled=false
AhrefsSync__Cron=0 1 1 * *
AhrefsSync__NotBeforeUtc=2026-07-01T01:00:00Z
AhrefsSync__BatchSize=100
AhrefsSync__MaxSitesPerRun=100000
AhrefsSync__TargetMode=subdomains
AhrefsSync__Protocol=both
AhrefsSync__VolumeMode=monthly
AhrefsSync__MonthlyAppBudgetUnits=975000
AhrefsSync__SafetyBufferUnits=25000
